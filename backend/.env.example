MONTY_PROVIDER=deepseek
MONTY_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
MONTY_MODEL=deepseek-flash
MONTY_THINKING=disabled
MONTY_MAX_TOKENS=1600
# OPENAI_API_KEY remains supported only when explicitly in backend/.env for legacy DeepSeek setup.
# A process-wide OpenAI key is never implicitly used for DeepSeek.
# For OpenAI: MONTY_PROVIDER=openai, MONTY_BASE_URL=https://api.openai.com/v1,
# OPENAI_API_KEY=..., and a model available to your account.
MONTY_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MONTY_SESSION_LIMIT=100
MONTY_GLOBAL_CALLS_PER_HOUR=300
MONTY_REQUESTS_PER_MINUTE=20
MONTY_IP_REQUESTS_PER_MINUTE=90

# Reply tokens per visitor session (input tokens are not included).
MONTY_SESSION_OUTPUT_TOKENS=300000

# Local CPU embeddings. Model weights download once; no embedding API key.
# This encoder currently supports this model only; switching requires code + reindex.
MONTY_EMBEDDING_MODEL=Xenova/multilingual-e5-small
MONTY_EMBEDDING_THREADS=2
# Optional persistent cache directory; default: backend/data/models
# MONTY_EMBEDDING_CACHE=/persistent/monty-models
