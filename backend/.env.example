GHOST_PROVIDER=deepseek
GHOST_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
GHOST_MODEL=deepseek-flash
GHOST_THINKING=disabled
GHOST_MAX_TOKENS=1600
# OPENAI_API_KEY remains supported only when explicitly in backend/.env for legacy DeepSeek setup.
# A process-wide OpenAI key is never implicitly used for DeepSeek.
# For OpenAI: GHOST_PROVIDER=openai, GHOST_BASE_URL=https://api.openai.com/v1,
# OPENAI_API_KEY=..., and a model available to your account.
GHOST_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
GHOST_SESSION_LIMIT=100
GHOST_GLOBAL_CALLS_PER_HOUR=300
GHOST_REQUESTS_PER_MINUTE=20
GHOST_IP_REQUESTS_PER_MINUTE=90
